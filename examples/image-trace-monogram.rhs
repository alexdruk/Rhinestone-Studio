{
  "version": 1,
  "product": "mug",
  "units": "mm",
  "canvas": {
    "width": 210,
    "height": 90
  },
  "cupColor": "#ffffff",
  "wrap": "front",
  "layers": [
    {
      "id": "monogram-trace",
      "type": "image",
      "name": "Monogram (Image Trace)",
      "visible": true,
      "imageSrc": "data:image/png;base64,",
      "xMm": 70,
      "yMm": 10,
      "widthMm": 70,
      "heightMm": 70,
      "threshold": 128,
      "invert": false,
      "blurRadiusPx": 1,
      "maxWidthPx": 400,
      "maxHeightPx": 400,
      "fillMode": "contour",
      "stoneSizeMm": 1.5,
      "gapMm": 0.3,
      "color": "jet"
    }
  ]
}
