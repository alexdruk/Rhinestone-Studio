# READ-004/READ-005 recognition-harness output: probe records, generated contact
# sheets, Playwright profile dirs. The app consumes only the baked floors derived
# from these; the intermediates are never tracked.
tools/font-certification/output/

# Scratch and one-off verification artifacts, never tracked. This section replaced
# ~85 per-milestone lines; one was once forgotten and four scratch scripts got
# tracked by mistake. Do NOT add new per-milestone lines. Put spikes under
# tools/scratch/, or name a script tools/<milestone>-verify.mjs with screenshots
# in tools/<milestone>-...-screenshots/.
tools/scratch/
tools/*-verify.mjs
tools/*-verification.mjs
tools/*-screenshots/

# Pre-convention one-offs fitting neither glob. Do not imitate these names.
tools/rc-014-font-spotcheck.mjs
tools/rs-3011-step4-flash-check.mjs
tools/rs-3011-step4-flash-check-heavy.mjs
