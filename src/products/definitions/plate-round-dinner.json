      "min": 18,
      "average": 25,
      "max": 32
    },
    "centerDepthMm": {
      "description": "Vertical drop from rim plane to center well surface.",
      "min": 7,
      "average": 12,
      "max": 18,
      "confidence": "provisional"
    },
    "footRingOuterDiameterMm": {
      "description": "Outside diameter of the supporting foot ring.",
      "min": 135,
      "average": 165,
      "max": 195,
      "confidence": "provisional"
    },
    "footRingHeightMm": {
      "description": "Height of the foot ring above the table surface.",
      "min": 3,
      "average": 5,
      "max": 8,
      "confidence": "provisional"
    }
  },
  "weightGrams": {
    "description": "Approximate weight for a conventional porcelain or stoneware dinner plate.",
    "min": 650,
    "average": 800,
    "max": 1050
  },
  "profile": {
    "type": "radialPlateProfile",
    "center": {
