    },
    "rimBand": {
      "name": "Rim Band",
      "shape": "annulus",
      "outerDiameterSource": "outerDiameterMm",
      "innerDiameterSource": "innerWellDiameterMm",
      "enabled": true
    },
    "fullTopSurface": {
      "name": "Full Top Surface",
      "shape": "circle",
      "diameterSource": "outerDiameterMm",
      "enabled": true
    }
  },
  "defaults": {
    "outerDiameterMm": 270,
    "innerWellDiameterMm": 195,
    "overallHeightMm": 25,
    "centerDepthMm": 12,
    "footRingOuterDiameterMm": 165,
    "footRingHeightMm": 5,
    "weightGrams": 800,
    "colorId": "white",
    "designTarget": "centerWell"
