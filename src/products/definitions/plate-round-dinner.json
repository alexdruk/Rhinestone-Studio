  "validation": {
    "outerDiameterIncludesRim": true,
    "requireInnerWellSmallerThanOuterDiameter": true,
    "requireDerivedRimWidthConsistency": true,
    "requirePositiveProfileDimensions": true,
    "requireDesignTargetInsideOuterDiameter": true
  },
  "research": {
    "scope": "Conventional round rimmed dinner plates; excludes pasta plates, chargers, coupe/rimless plates, square plates, and divided plates.",
    "notes": [
      "The ranges are a practical modeling envelope, not an industry standard.",
      "Outer diameter always includes the complete rim.",
      "Rim width is radial.",
      "Center-depth and foot-ring ranges should be validated against manufacturer drawings or physical samples before production-grade modeling."
    ]
  }
