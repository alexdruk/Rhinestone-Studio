      "description": "Complete outside diameter including the full rim.",
      "min": 250,
      "average": 270,
      "max": 300
    },
    "innerWellDiameterMm": {
      "description": "Diameter of the central well measured where the rim begins.",
      "min": 175,
      "average": 195,
      "max": 215
    },
    "rimWidthMm": {
      "description": "Radial rim width; derived from outer and inner diameters.",
      "min": 25,
      "average": 37.5,
      "max": 55,
