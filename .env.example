# IMG-022 "Redraw with AI" settings, read by tools/dev-server.mjs (server/redraw/env.mjs).
# Copy this file to .env (which git ignores) and fill in the values. A variable set in the
# environment wins over .env. The redraw routes are on when REDRAW_ACCESS_CODE is set and either
# OPENAI_API_KEY is set or REDRAW_FAKE=1; otherwise the app runs without them and hides the button.

# OpenAI API key. Server-side only: never sent to the browser or logged. Not needed when REDRAW_FAKE=1.
OPENAI_API_KEY=

# Image model and quality sent to OpenAI's image edit endpoint.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Required. The code the operator types in the consent dialog; requests without the matching
# X-Redraw-Access-Code header get 401. Without it, the redraw routes are off (404).
REDRAW_ACCESS_CODE=

# Redraw requests allowed per client IP per hour (in memory, reset on restart).
REDRAW_RATE_LIMIT_PER_HOUR=20

# Seconds to wait for one OpenAI call before giving up (504). A timed-out call is not retried.
REDRAW_TIMEOUT_SECONDS=300

# Free text shown in the consent dialog, e.g. "about $0.05 per image". May be left empty.
REDRAW_COST_LABEL=

# 1 returns a fixed test image and makes no OpenAI call (local and browser checks).
REDRAW_FAKE=
